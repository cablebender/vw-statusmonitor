{
    "settings": {
        "check_interval": 30,
        "default_timeout": 3,
        "listen_address": "0.0.0.0",
        "listen_port": 8080,

        "logging": {
            "level": "INFO",
            "max_size_mb": 5,
            "backup_count": 5
        },

        "history": {
            "enabled": true,
            "retention_days": 30,
            "default_display_hours": 24
        }
    },

    "checks": [
        {
            "name": "Internet",
            "description": "Internet-Verbindung",
            "type": "ping",
            "target": "8.8.8.8"
        },

        {
            "name": "Gateway",
            "description": "Default Gateway",
            "type": "ping",
            "target": "10.0.0.1",
            "depends_on": [
                "Internet"
            ],
            "action": {
                "enabled": true,
                "down_for": 900,
                "type": "powershell",
                "script": "scripts/cisco-vpn-reset.ps1",
                "timeout": 60
            }
        },

        {
            "name": "Webserver",
            "description": "Interner Webserver",
            "type": "http",
            "target": "https://10.0.0.20/",
            "expected_status": 200,
            "verify_tls": false,
            "depends_on": [
                "Gateway"
            ]
        },

        {
            "name": "LDAP",
            "description": "Domain Controller LDAP",
            "type": "tcp",
            "target": "10.0.0.10",
            "port": 389,
            "depends_on": [
                "Gateway"
            ]
        },

        {
            "name": "Anwendung",
            "description": "Fachanwendung",
            "type": "http",
            "target": "https://10.0.0.30/",
            "expected_status": 403,
            "verify_tls": false,
            "depends_on": [
                "Webserver",
                "LDAP"
            ]
        }
    ]
}
