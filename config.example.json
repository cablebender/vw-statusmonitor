{
    "settings": {
        "check_interval": 30,
        "default_timeout": 3,
        "listen_address": "0.0.0.0",
        "listen_port": 8080
    },
    "checks": [
        {
            "name": "Gateway",
            "description": "Default Gateway",
            "type": "ping",
            "target": "10.0.0.1"
        },
        {
            "name": "Webserver",
            "description": "Interner Webserver",
            "type": "http",
            "target": "https://10.0.0.20/",
            "expected_status": 200,
            "verify_tls": false
        },
        {
            "name": "LDAP",
            "description": "Domain Controller LDAP",
            "type": "tcp",
            "target": "10.0.0.10",
            "port": 389
        }
    ]
}
